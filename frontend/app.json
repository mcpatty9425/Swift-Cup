{
  "expo": {
    "name": "The Swifty Cup 2026",
    "slug": "the-swifty-cup-2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swiftycup",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.theswiftycup.v5v31d",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose player profile photos",
        "NSCameraUsageDescription": "Take a player profile photo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#07111f"
      },
      "package": "com.emergent.theswiftycup.v5v31d",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#07111f"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-image-picker",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
